{
  "name": "classroom-interpretation-v0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/local.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "build:container": "npm run build && tsc -p tsconfig.container.json",
    "start": "tsx server/local.ts",
    "start:container": "node .cache/container-runtime/server/container.js",
    "test": "vitest run --dir tests",
    "check": "npm run build:container && npm test && npm run test:server-runtime && node --test scripts/container-runtime.test.mjs",
    "test:server-runtime": "tsc -p tsconfig.server.json --noEmit false --allowImportingTsExtensions false && node --test scripts/server-runtime.test.mjs",
    "test:container-runtime": "npm run build:container && node --test scripts/container-runtime.test.mjs",
    "test:soak": "tsx scripts/soak.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.2.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
